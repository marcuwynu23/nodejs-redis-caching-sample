{
  "name": "nodejs-redis-caching-sample",
  "version": "1.0.0",
  "type": "module",
  "description": "A backend-only TypeScript project demonstrating Redis caching with PostgreSQL and Drizzle ORM.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
